Cell[BoxData[{
 RowBox[{
  RowBox[{"h0", "[", "z_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "I"}], "/", "z"}], " ", 
   RowBox[{"Exp", "[", 
    RowBox[{"I", " ", "z"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h2", "[", "z_", "]"}], ":=", 
  RowBox[{
   RowBox[{"I", "/", "z"}], " ", 
   RowBox[{"Exp", "[", 
    RowBox[{"I", " ", "z"}], "]"}], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", " ", 
     RowBox[{"3", " ", 
      RowBox[{"I", "/", "z"}]}], "  ", "-", " ", 
     RowBox[{"3", "/", 
      RowBox[{"z", "^", "2"}]}]}], ")"}]}]}]}], "Input",
 CellChangeTimes->{{3.937902445543804*^9, 3.9379025276060104`*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"53477648-6784-e94e-abb9-12e45cfe0403"],

