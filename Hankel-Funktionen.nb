Cell[BoxData[{
 RowBox[{
  RowBox[{"h0", "[", "z_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "I"}], "/", "z"}], " ", 
   RowBox[{"Exp", "[", 
    RowBox[{"I", " ", "z"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h2", "[", "z_", "]"}], ":=", 
  RowBox[{
   RowBox[{"I", "/", "z"}], " ", 
   RowBox[{"Exp", "[", 
    RowBox[{"I", " ", "z"}], "]"}], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", " ", 
     RowBox[{"3", " ", 
      RowBox[{"I", "/", "z"}]}], "  ", "-", " ", 
     RowBox[{"3", "/", 
      RowBox[{"z", "^", "2"}]}]}], ")"}]}]}]}], "Input",
